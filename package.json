{
  "name": "open-apprentice-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "services/engine"
  ],
  "engines": {
    "node": ">=22.12 <23 || >=24"
  },
  "scripts": {
    "test": "npm test -w services/engine",
    "build:web": "npm run build -w apps/web",
    "test:geometry": "node --experimental-strip-types --test tests/e2e/geometry.test.mjs",
    "test:snap": "node --experimental-strip-types --test tests/web/snap.test.ts",
    "test:e2e": "OA_E2E=1 node --test --test-concurrency=1 tests/e2e/ui.test.mjs tests/e2e/journey.test.mjs tests/e2e/campaign.test.mjs tests/e2e/adapt.test.mjs tests/e2e/adapt_preferences.test.mjs",
    "lint": "npm run lint -w apps/web"
  },
  "devDependencies": {
    "axe-core": "^4.10.2"
  }
}
