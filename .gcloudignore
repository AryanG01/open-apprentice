# What gcloud builds submit must NOT upload. The Dockerfile copies only what it needs; everything else stays out.
.git
.env
.env.*
!.env.example
gym/
node_modules/
**/node_modules/
.venv/
**/.venv/
dist/
apps/web/dist/
results/
benchmarks/final/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
# tests stay out, except the owner-authored draw.io samples the demo image ships (docker/demo.Dockerfile)
tests/*
!tests/fixtures/
tests/fixtures/*
!tests/fixtures/drawio_corpus/
tests/fixtures/drawio_corpus/*
!tests/fixtures/drawio_corpus/dev/
.oa-store/
.superpowers/
.uv-cache/
.hypothesis/
.claude/
.github/
